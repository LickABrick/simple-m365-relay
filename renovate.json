{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "enabled": true,
  "extends": [
    "config:recommended",
    ":timezone(Europe/Amsterdam)",
    ":dependencyDashboard",
    ":prImmediately",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "groupName": "all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "major updates (separate)",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "docker images",
      "matchDatasources": [
        "docker"
      ]
    }
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tarickb/sasl-xoauth2",
      "extractVersionTemplate": "^release-(?<version>.*)$",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG\\s+SASL_XOAUTH2_VERSION=(?<currentValue>\\S+)\\n"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "depNameTemplate": "tailwindcss",
      "managerFilePatterns": [
        "/^apps/web/Dockerfile$/"
      ],
      "matchStrings": [
        "tailwindcss@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "npm"
    }
  ],
  "schedule": [
    "before 07:00 on monday"
  ]
}
